FROM node:22.19.0-alpine3.22 AS build

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

COPY index.html postcss.config.js tailwind.config.js vite.config.js visa_seva_indianvisaonline_reviews_refined.json ./
COPY public ./public
COPY src ./src

ARG VITE_SHOWCASE_BACKEND=enabled
ENV VITE_SHOWCASE_BACKEND=${VITE_SHOWCASE_BACKEND}
RUN npm run build

FROM caddy:2.10.2-alpine

RUN setcap -r /usr/bin/caddy
COPY Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/dist /srv

ENV WEB_ROOT=/srv \
    API_UPSTREAM=api:3000 \
    BIND_ADDRESS=0.0.0.0

EXPOSE 8080
