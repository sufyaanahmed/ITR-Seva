# Local showcase values only. Use a unique value and do not commit the resulting .env.
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
DATABASE_MAX_CONNECTIONS=32
MAX_IN_FLIGHT_REQUESTS=512
RATE_LIMIT_PER_SECOND=2000
SESSION_RATE_LIMIT_PER_SECOND=100
STATUS_RATE_LIMIT_PER_SECOND=30
REQUEST_TIMEOUT_MS=3000
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
VITE_SHOWCASE_BACKEND=enabled
