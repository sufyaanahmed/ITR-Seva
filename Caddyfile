{
	# This showcase needs no runtime configuration endpoint. Reload Caddy through
	# the process supervisor after changing this file instead.
	admin off
}

http://:8080 {
	bind 127.0.0.1
	root * ./dist
	encode zstd gzip

	# Defense in depth: these operational paths must never fall through to the SPA
	# or become reachable through the public tunnel.
	@privatePaths path /metrics /metrics/* /admin /admin/* /debug /debug/* /internal /internal/* /actuator /actuator/*

	header {
		-Server
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; frame-src 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; media-src 'self'; worker-src 'self' blob:; manifest-src 'self'"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "accelerometer=(), autoplay=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), publickey-credentials-get=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
	}

	# ngrok terminates public HTTPS and forwards this header. A short, host-only
	# HSTS policy protects the public hostname without preloading or affecting its
	# parent domain. Local http://localhost:8080 does not receive HSTS; browsers
	# ignore HSTS delivered over plain HTTP in any case.
	@publicHttps header X-Forwarded-Proto https
	header @publicHttps Strict-Transport-Security "max-age=86400"

	# Avoid a filesystem existence check on every SPA request. At high arrival
	# rates, try_files becomes substantially more expensive than deterministic
	# routing. Hashed bundles and known public-file extensions go directly to the
	# file server; every other public route is the SPA entry point.
	route {
		respond @privatePaths 404

		# The public tunnel reaches only Caddy. Dynamic traffic is proxied to the
		# loopback-bound Rust API; operator endpoints live on a separate port.
		@api path /api/*
		handle @api {
			reverse_proxy 127.0.0.1:3000 {
				health_uri /internal/ready
				health_port 9090
				health_interval 10s
				health_timeout 2s
			}
		}

		@immutableAssets path /assets/*
		handle @immutableAssets {
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}

		@publicFiles path *.avif *.gif *.ico *.jpeg *.jpg *.json *.png *.svg *.txt *.webmanifest *.webp *.woff *.woff2 *.xml
		handle @publicFiles {
			header Cache-Control "public, max-age=86400"
			file_server
		}

		handle {
			rewrite * /index.html
			header Cache-Control "no-store"
			file_server
		}
	}
}
